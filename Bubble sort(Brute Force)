1.Bubble Sort using Brute Force

#include<iostream>
using namespace std;
int main()
{
   int n,temp;
   cout<<"Enter no of elements:";
   cin>>n;
   int a[n];
   cout<<"Enter elements:"<<endl;
   for(int i=0;i<n;i++)
   {
        cin>>a[i];
   }
   for(int i=0;i<n-1;i++)
   {
      bool flag=false;
      for(int j=0;j<n-1-i;j++)
      {
         if(a[j]>a[j+1])
         {
            temp=a[j];
            a[j]=a[j+1];
            a[j+1]=temp;
            flag=true;
         }
      }
      if(!flag)
      {
         break;
      }
   }
   cout<<"After sorting with bubble sort:";
   for(int i=0;i<n;i++)
   {
      cout<<a[i]<<" ";
   }
   cout<<"\n";
   return 0;
}
