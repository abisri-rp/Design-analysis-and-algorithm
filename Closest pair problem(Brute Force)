3. Closest Pair Problem using Brute Force

#include<iostream>
#include<cmath>
#include<cfloat>
using namespace std;
int main()
{
   int n;
   cout<<"Enter no of points:";
   cin>>n;
   int x[n],y[n];
   for(int i=1;i<=n;i++)
   {
      cout<<"Enter x-coordinate of point "<<i<<" is";
      cin>>x[i];
      cout<<"Enter y-coordinate of point "<<i<<" is";
      cin>>y[i];
   }
   float d=FLT_MAX;
   int p1=0,p2=0;
   cout<<"\n All pairs and distances \n";
   for(int i=1;i<=n-1;i++)
   {
      for(int j=i+1;j<=n;j++)
      {
	 double dist=sqrt(pow((x[i]-x[j]),2)+pow((y[i]-y[j]),2));
	 cout<<"Pair:("<<x[i]<<","<<y[i]<<") and ("<<x[j]<<","<<y[j]<<")\t";
	 cout<<"Distance="<<dist<<endl;
	 if(dist<d)
	 {
	    d=dist;
	    p1=i;
	    p2=j;
	 }
      }
   }
   cout<<"\n Closest pair "<<endl;
   cout<<"Closest pair:("<<x[p1]<<","<<y[p1]<<") and ("<<x[p2]<<","<<y[p2]<<")\n";
   cout<<"Minimum distance="<<d<<endl;
   return 0;
}
