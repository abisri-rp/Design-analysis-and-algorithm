#include<iostream>
using namespace std;
int main()
{
   int n,v,j;
   cout<<"Enter no of elements:";
   cin>>n;
   if(n<0)
   {
      cout<<"Entered invalued input\n";
      cout<<"Enter again:\n";
      cin>>n;
   }
   int A[n];
   cout<<"Enter elements:\n";
   for(int i=0;i<n;i++)
   {
      cin>>A[i];
      if(A[i]<0)
      {
         cout<<"Entered invalued input\n";
         cout<<"Enter again:\n";
         cin>>A[i];
      }
   }
   for(int i=1;i<n;i++)
   {
      v=A[i];
      j=i-1;
      while(j>=0 && A[j]>v)
      {
         A[j+1]=A[j];
         j=j-1;
      }
      A[j+1]=v;
   }
   cout<<"After insertion sort:"<<endl;
   for(int i=0;i<n;i++)
      cout<<A[i]<<"  ";
   cout<<endl;
}
